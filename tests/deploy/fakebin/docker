CORE_SERVICES = ("workspace", "computer-use-server", "retention-guard")
WEBUI_SERVICES = ("open-webui", "postgres", "open-webui-init")
PROXY_SERVICES = ("proxy",)
CLEANUP_SERVICE = "cleanup"


def state_dir() -> Path:
    raw = os.environ.get("FAKE_DOCKER_STATE", "")
    if not raw:
        sys.stderr.write("FAKE_DOCKER_STATE is required\n")
        sys.exit(2)
    path = Path(raw)
    path.mkdir(parents=True, exist_ok=True)
    (path / "networks").mkdir(exist_ok=True)
    return path


def log(argv: list[str], state: Path) -> None:
    line = " ".join(argv)
    with (state / "ops.log").open("a", encoding="utf-8") as stream:
        stream.write(line + "\n")


def write_json(path: Path, payload) -> None:
    path.write_text(json.dumps(payload), encoding="utf-8")


def append_json_list(path: Path, payload) -> None:
    records = []
    if path.exists():
        try:
            existing = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise SystemExit(f"malformed {path.name}") from exc
        if not isinstance(existing, list):
            raise SystemExit(f"malformed {path.name}")
        records = existing
    records.append(payload)
    write_json(path, records)


def network_path(state: Path, name: str) -> Path:
    return state / "networks" / f"{name}.json"


def hold_named(state: Path, env_name: str, entered_name: str) -> None:
    hold = os.environ.get(env_name, "")
    if not hold:
        return
    marker = Path(hold)
    (state / entered_name).write_text(str(os.getpid()), encoding="utf-8")
    while marker.exists():
        time.sleep(0.05)


def inspect_network(state: Path, name: str) -> int:
    hold_named(state, "FAKE_DOCKER_HOLD_INSPECT", "entered-inspect")
    path = network_path(state, name)
    if path.exists():
        sys.stdout.write(path.read_text(encoding="utf-8"))
        return 0
    inspect_error = state / "inspect-error.json"
    if inspect_error.exists():
        payload = json.loads(inspect_error.read_text(encoding="utf-8"))
        sys.stderr.write(str(payload.get("message", "inspect failed")) + "\n")
        return int(payload.get("code", 1))
    sys.stderr.write(f"Error: No such network: {name}\n")
    return 1




def create_network(state: Path, argv: list[str]) -> int:
    name = argv[-1]
    script = state / "create-script.json"
    if script.exists():
        payload = json.loads(script.read_text(encoding="utf-8"))
        if payload.get("once"):
            script.unlink()
        if payload.get("write"):
            write_json(network_path(state, name), payload["write"])
        sys.stderr.write(str(payload.get("message", "create failed")) + "\n")
        return int(payload.get("code", 1))
    driver = "bridge"
    internal = False
    subnet = ""
    gateway = ""
    args = argv[:]
    while args:
        token = args.pop(0)
        if token == "--driver" and args:
            driver = args.pop(0)
        elif token == "--internal":
            internal = True
        elif token == "--subnet" and args:
            subnet = args.pop(0)
        elif token == "--gateway" and args:
            gateway = args.pop(0)
        elif token == "--label" and args:
            args.pop(0)
    net_id = f"id-{name}"
    write_json(
        network_path(state, name),
        {
            "Name": name,
            "Id": net_id,
            "Driver": driver,
            "Internal": internal,
            "Options": {
                "com.docker.network.bridge.name": "br-" + net_id[:12],
            },
            "IPAM": {"Config": [{"Subnet": subnet, "Gateway": gateway}]},
        },
    )
    return 0


def compose_files(argv: list[str]) -> list[str]:
    files = []
    args = argv[:]
    while args:
        token = args.pop(0)
        if token in {"-f", "--file"} and args:
            files.append(args.pop(0))
    return files


def is_snapshot_file(path: str) -> bool:
    return Path(path).name.endswith(".up.json")


def stack_from_files(files: list[str]) -> str:
    names = " ".join(Path(path).name for path in files)
    joined = " ".join(files)
    if "proxy.up.json" in names or "compose.proxy.yml" in joined:
        return "proxy"
    if "webui.up.json" in names or "compose.webui.override.yml" in joined or "docker-compose.webui.yml" in joined:
        return "webui"
    if "core.up.json" in names or "compose.core.override.yml" in joined or "docker-compose.yml" in joined:
        return "core"
    return "unknown"



def running_path(state: Path) -> Path:
    return state / "running.json"


def load_running(state: Path) -> dict:
    path = running_path(state)
    if not path.exists():
        return {}
    return json.loads(path.read_text(encoding="utf-8"))


def save_running(state: Path, payload: dict) -> None:
    write_json(running_path(state), payload)


def profiles_active(argv: list[str]) -> set[str]:
    inherited = os.environ.get("COMPOSE_PROFILES", "")
    names = {item for item in inherited.split(",") if item}
    args = argv[:]
    while args:
        token = args.pop(0)
        if token in {"--profile", "--profiles"} and args:
            names.update(item for item in args.pop(0).split(",") if item)
    return names


def remove_orphans(argv: list[str]) -> bool:
    if "--remove-orphans" in argv:
        return True
    value = os.environ.get("COMPOSE_REMOVE_ORPHANS", "")
    return value.lower() in {"1", "true", "yes"}


def services_for(stack: str, profiles: set[str]) -> list[str]:
    if stack == "core":
        names = list(CORE_SERVICES)
        if "manual-maintenance" in profiles:
            names.append(CLEANUP_SERVICE)
        return names
    if stack == "webui":
        return list(WEBUI_SERVICES)
    if stack == "proxy":
        return list(PROXY_SERVICES)
    return []


def compose_config(state: Path, argv: list[str]) -> int:
    hold_named(state, "FAKE_DOCKER_HOLD_CONFIG", "entered-config")
    fail = state / "config-fail"
    if fail.exists():
        sys.stderr.write("compose config failed\n")
        return 1
    files = compose_files(argv)
    config_dir = state / "config"
    mapping = {
        "compose.core.override.yml": "core.json",
        "compose.webui.override.yml": "webui.json",
        "compose.proxy.yml": "proxy.json",
        "docker-compose.yml": "core.json",
        "docker-compose.webui.yml": "webui.json",
    }
    chosen = None
    for path in files:
        for key, name in mapping.items():
            if path.endswith(key):
                chosen = config_dir / name
                break
    if chosen is None or not chosen.exists():
        sys.stderr.write("resolved compose document is missing\n")
        return 1
    try:
        payload = json.loads(chosen.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, UnicodeError):
        sys.stderr.write("resolved compose document is missing\n")
        return 1
    if payload.get("__unresolved__") is True:
        body = {key: value for key, value in payload.items() if key != "__unresolved__"}
        try:
            payload = interpolate_value(body, os.environ)
        except UnsupportedInterpolation as exc:
            sys.stderr.write(f"unsupported interpolation: {exc}\n")
            return 1
    sys.stdout.write(json.dumps(payload))
    return 0


def hold_up(state: Path) -> None:
    hold_named(state, "FAKE_DOCKER_HOLD_UP", "entered-up")

def compose_up(state: Path, argv: list[str]) -> int:
    files = compose_files(argv)
    hold_up(state)
    stack = stack_from_files(files)
    snapshot = any(is_snapshot_file(path) for path in files)
    executed = state / "executed.json"
    payload = {
        "stack": stack,
        "files": files,
        "snapshot": snapshot,
        "profiles": sorted(profiles_active(argv)),
        "remove_orphans": remove_orphans(argv),
        "env_remove_orphans": os.environ.get("COMPOSE_REMOVE_ORPHANS", ""),
        "env_profiles": os.environ.get("COMPOSE_PROFILES", ""),
        "argv": argv,
        "no_build": "--no-build" in argv,
        "pull": None,
        "build": "--build" in argv,
    }
    args = argv[:]
    while args:
        token = args.pop(0)
        if token == "--pull" and args:
            payload["pull"] = args.pop(0)
        elif token.startswith("--pull="):
            payload["pull"] = token.split("=", 1)[1]

    if snapshot and files:
        first = Path(files[0])
        if first.exists():
            try:
                raw_document = json.loads(first.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError, UnicodeError):
                raw_document = None
            payload["document"] = raw_document
            if raw_document is not None:
                try:
                    payload["consumer_document"] = interpolate_value(
                        raw_document, os.environ
                    )
                except UnsupportedInterpolation as exc:
                    sys.stderr.write(f"unsupported interpolation: {exc}\n")
                    return 1
        payload["snapshot_path"] = str(first)
    else:
        live = state / "config" / f"{stack}.json"
        if live.exists():
            try:
                payload["document"] = json.loads(live.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError, UnicodeError):
                payload["document"] = None
        payload["source_path"] = str(live)

    with executed.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(payload) + "\n")
    fail = state / f"up-fail-{stack}"
    running = load_running(state)
    if remove_orphans(argv):
        keep = set(services_for(stack, profiles_active(argv)))
        running = {name: owner for name, owner in running.items() if name in keep or owner == stack}
    for name in services_for(stack, profiles_active(argv)):
        running[name] = stack
    save_running(state, running)
    starts = state / "starts.log"
    with starts.open("a", encoding="utf-8") as stream:
        if fail.exists():
            stream.write(f"{stack}:failed\n")
        else:
            stream.write(stack + "\n")
    if fail.exists():
        sys.stderr.write(f"compose up failed for {stack}\n")
        return 1
    return 0


def docker_info(state: Path, argv: list[str] | None = None) -> int:
    payload = {
        "ID": "fake-daemon-" + hashlib.sha256(str(state).encode("utf-8")).hexdigest(),
        "Name": "ocu-fake-docker",
        "Driver": "overlay2",
        "SecurityOptions": [],
        "CgroupDriver": "systemd",
        "FirewallBackend": "iptables",
        "Rootless": False,
        "DockerRootDir": str(state / "docker-root"),
    }
    override = state / "docker-info.json"
    if override.exists():
        payload.update(json.loads(override.read_text(encoding="utf-8")))
    if payload.get("error"):
        sys.stderr.write(str(payload.get("message", "docker info failed")) + "\n")
        return int(payload.get("code", 1))
    fmt = ""
    args = list(argv or [])
    while args:
        token = args.pop(0)
        if token in {"--format", "-f"} and args:
            fmt = args.pop(0)
    if fmt and fmt not in {"{{json .}}", "{{.ID}}"}:
        sys.stderr.write("unsupported docker info format\n")
        return 1
    if fmt == "{{.ID}}":
        sys.stdout.write(str(payload.get("ID") or "") + "\n")
        return 0
    sys.stdout.write(json.dumps(payload))
    return 0


def docker_context_inspect(state: Path, argv: list[str]) -> int:
    payload = {
        "Name": "default",
        "Endpoints": {"docker": {"Host": "unix:///var/run/docker.sock"}},
    }
    override = state / "docker-context.json"
    if override.exists():
        payload.update(json.loads(override.read_text(encoding="utf-8")))
    if payload.get("error"):
        sys.stderr.write(str(payload.get("message", "docker context inspect failed")) + "\n")
        return int(payload.get("code", 1))
    sys.stdout.write(json.dumps(payload))
    del argv
    return 0


