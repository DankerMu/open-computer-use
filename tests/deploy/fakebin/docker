def containers_path(state: Path) -> Path:
    return state / "containers.json"


def load_containers(state: Path) -> list[dict]:
    path = containers_path(state)
    if not path.exists():
        return []
    return json.loads(path.read_text(encoding="utf-8"))


def save_containers(state: Path, payload: list[dict]) -> None:
    write_json(containers_path(state), payload)


def match_filters(container: dict, filters: list[str]) -> bool:
    for item in filters:
        if "=" not in item:
            return False
        key, value = item.split("=", 1)
        if key == "label":
            labels = container.get("Labels") or {}
            if "=" in value:
                name, expected = value.split("=", 1)
                if labels.get(name) != expected:
                    return False
            elif value not in labels:
                return False
        elif key == "status":
            if container.get("State") != value:
                return False
        else:
            return False
    return True


def docker_ps(state: Path, argv: list[str]) -> int:
    quiet = False
    include_all = False
    filters: list[str] = []
    args = argv[:]
    while args:
        token = args.pop(0)
        if token == "-q":
            quiet = True
        elif token in {"-a", "--all"}:
            include_all = True
        elif token == "--filter" and args:
            filters.append(args.pop(0))
        else:
            sys.stderr.write("unsupported docker command\n")
            return 1
    if not quiet:
        sys.stderr.write("unsupported docker command\n")
        return 1
    selected = []
    for container in load_containers(state):
        if not include_all and container.get("State") != "running":
            continue
        if not match_filters(container, filters):
            continue
        selected.append(container)
    for container in selected:
        sys.stdout.write(container["Id"] + "\n")
    return 0


def docker_inspect(state: Path, argv: list[str]) -> int:
    fmt = ""
    args = argv[:]
    target = None
    while args:
        token = args.pop(0)
        if token in {"--format", "-f"} and args:
            fmt = args.pop(0)
        elif not token.startswith("-") and target is None:
            target = token
        else:
            sys.stderr.write("unsupported docker command\n")
            return 1
    if not target:
        sys.stderr.write("docker inspect requires a container\n")
        return 1
    fail_marker = state / f"inspect-fail-{target}"
    if fail_marker.exists():
        sys.stderr.write(f"Error: permission denied: {target}\n")
        return 1
    for container in load_containers(state):
        if container["Id"] != target and container.get("Name") != target:
            continue
        if fmt == "{{.State.StartedAt}}":
            sys.stdout.write(container.get("StartedAt", "") + "\n")
            return 0
        if fmt == "{{.Name}}":
            sys.stdout.write("/" + container.get("Name", target) + "\n")
            return 0
        sys.stdout.write(json.dumps(container))
        return 0
    sys.stderr.write(f"Error: No such container: {target}\n")
    return 1


def docker_stop(state: Path, argv: list[str]) -> int:
    time_limit = None
    args = argv[:]
    target = None
    while args:
        token = args.pop(0)
        if token in {"--time", "-t"} and args:
            time_limit = args.pop(0)
        elif not token.startswith("-") and target is None:
            target = token
        else:
            sys.stderr.write("unsupported docker command\n")
            return 1
    if not target:
        sys.stderr.write("docker stop requires a container\n")
        return 1
    if time_limit != "30":
        sys.stderr.write("unsupported docker command\n")
        return 1
    containers = load_containers(state)
    for container in containers:
        if container["Id"] != target and container.get("Name") != target:
            continue
        container["State"] = "exited"
        save_containers(state, containers)
        (state / "stopped.log").write_text(
            container["Id"] + "\n",
            encoding="utf-8",
        )
        sys.stdout.write(container["Id"] + "\n")
        return 0
    sys.stderr.write(f"Error: No such container: {target}\n")
    return 1


