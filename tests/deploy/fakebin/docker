"""Independent fake Docker/Compose CLI driven by a state directory."""

from __future__ import annotations

import json
import os
from pathlib import Path
import sys
import time


def state_dir() -> Path:
    raw = os.environ.get("FAKE_DOCKER_STATE", "")
    if not raw:
        sys.stderr.write("FAKE_DOCKER_STATE is required\n")
        sys.exit(2)
    path = Path(raw)
    path.mkdir(parents=True, exist_ok=True)
    (path / "networks").mkdir(exist_ok=True)
    return path


def log(argv: list[str], state: Path) -> None:
    line = " ".join(argv)
    with (state / "ops.log").open("a", encoding="utf-8") as stream:
        stream.write(line + "\n")


def write_json(path: Path, payload) -> None:
    path.write_text(json.dumps(payload), encoding="utf-8")


def network_path(state: Path, name: str) -> Path:
    return state / "networks" / f"{name}.json"


def inspect_network(state: Path, name: str) -> int:
    path = network_path(state, name)
    if path.exists():
        sys.stdout.write(path.read_text(encoding="utf-8"))
        return 0
    inspect_error = state / "inspect-error.json"
    if inspect_error.exists():
        payload = json.loads(inspect_error.read_text(encoding="utf-8"))
        sys.stderr.write(str(payload.get("message", "inspect failed")) + "\n")
        return int(payload.get("code", 1))
    sys.stderr.write(f"Error: No such network: {name}\n")
    return 1


def create_network(state: Path, argv: list[str]) -> int:
    name = argv[-1]
    script = state / "create-script.json"
    if script.exists():
        payload = json.loads(script.read_text(encoding="utf-8"))
        if payload.get("once"):
            script.unlink()
        if payload.get("write"):
            write_json(network_path(state, name), payload["write"])
        sys.stderr.write(str(payload.get("message", "create failed")) + "\n")
        return int(payload.get("code", 1))
    driver = "bridge"
    internal = False
    subnet = ""
    gateway = ""
    args = argv[:]
    while args:
        token = args.pop(0)
        if token == "--driver" and args:
            driver = args.pop(0)
        elif token == "--internal":
            internal = True
        elif token == "--subnet" and args:
            subnet = args.pop(0)
        elif token == "--gateway" and args:
            gateway = args.pop(0)
        elif token == "--label" and args:
            args.pop(0)
    write_json(
        network_path(state, name),
        {
            "Name": name,
            "Id": f"id-{name}",
            "Driver": driver,
            "Internal": internal,
            "IPAM": {"Config": [{"Subnet": subnet, "Gateway": gateway}]},
        },
    )
    return 0


def compose_config(state: Path, argv: list[str]) -> int:
    fail = state / "config-fail"
    if fail.exists():
        sys.stderr.write("compose config failed\n")
        return 1
    files = []
    args = argv[:]
    while args:
        token = args.pop(0)
        if token in {"-f", "--file"} and args:
            files.append(args.pop(0))
        elif token == "--format" and args:
            args.pop(0)
    config_dir = state / "config"
    mapping = {
        "compose.core.override.yml": "core.json",
        "compose.webui.override.yml": "webui.json",
        "compose.proxy.yml": "proxy.json",
        "docker-compose.yml": "core.json",
        "docker-compose.webui.yml": "webui.json",
    }
    chosen = None
    for path in files:
        for key, name in mapping.items():
            if path.endswith(key):
                chosen = config_dir / name
                break
    if chosen is None or not chosen.exists():
        sys.stderr.write("resolved compose document is missing\n")
        return 1
    sys.stdout.write(chosen.read_text(encoding="utf-8"))
    return 0


def compose_up(state: Path, argv: list[str]) -> int:
    hold = os.environ.get("FAKE_DOCKER_HOLD_UP", "")
    if hold:
        marker = Path(hold)
        while marker.exists():
            time.sleep(0.05)
    files = []
    args = argv[:]
    while args:
        token = args.pop(0)
        if token in {"-f", "--file"} and args:
            files.append(args.pop(0))
    label = "unknown"
    joined = " ".join(files)
    if "compose.proxy.yml" in joined:
        label = "proxy"
    elif "compose.webui.override.yml" in joined or "docker-compose.webui.yml" in joined:
        label = "webui"
    elif "compose.core.override.yml" in joined or "docker-compose.yml" in joined:
        label = "core"
    starts = state / "starts.log"
    with starts.open("a", encoding="utf-8") as stream:
        stream.write(label + "\n")
    if "--remove-orphans" in argv:
        sys.stderr.write("remove-orphans is forbidden\n")
        return 1
    return 0


def main(argv: list[str]) -> int:
    state = state_dir()
    log(argv, state)
    if len(argv) >= 2 and argv[0] == "network" and argv[1] == "inspect":
        name = argv[2]
        return inspect_network(state, name)
    if len(argv) >= 2 and argv[0] == "network" and argv[1] == "create":
        return create_network(state, argv[2:])
    if argv and argv[0] == "compose":
        rest = argv[1:]
        if "config" in rest:
            return compose_config(state, rest)
        if "up" in rest:
            return compose_up(state, rest)
        sys.stderr.write("unsupported compose command\n")
        return 1
    sys.stderr.write("unsupported docker command\n")
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
